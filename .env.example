# Core syntheca settings
SYNTHECA_USER_AGENT=mailto:your.email@example.org
SYNTHECA_DEFAULT_TIMEOUT=10.0
SYNTHECA_OPENALEX_BASE_URL=https://api.openalex.org
SYNTHECA_OPENAIRE_BASE_URL=https://api.openaire.eu/graph
SYNTHECA_ENABLE_PROGRESS=true
SYNTHECA_PERSIST_INTERMEDIATE=true
SYNTHECA_USE_CACHE_FOR_RETRIEVAL=false

# Optional local paths
# SYNTHECA_CACHE_DIR=.cache
# SYNTHECA_LOG_FILE=logs/syntheca.log

# University of Twente profile overrides
SYNTHECA_UT_OPENALEX_INSTITUTION_ID=https://openalex.org/I94624287
SYNTHECA_UT_PURE_OAI_ENDPOINT=https://ris.utwente.nl/ws/oai
SYNTHECA_UT_DEFAULT_AFFILIATION_UUID=491145c6-1c9b-4338-aedd-98315c166d7e

# Optional mapping overrides
# SYNTHECA_UT_FACULTY_MAPPING_PATH=src/syntheca/config/mappings/faculties.json
# SYNTHECA_UT_PUBLISHER_MAPPING_PATH=src/syntheca/config/mappings/publishers.json
# SYNTHECA_UT_CORRECTIONS_MAPPING_PATH=src/syntheca/config/mappings/corrections.json
